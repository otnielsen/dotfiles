#!/bin/sh

set -eu

menu='fuzzel --dmenu --only-match'
conf_dir=~/.config/game-menu
menu_options=$(cat "$conf_dir/games.json")
titles=$(printf '%s' "$menu_options" | jq -r 'keys[]')

icon_dir="$conf_dir/icons"
cd "$icon_dir"
icon_menu=''
while read -r title || [ -n "$title" ]; do
    path=$(printf '%s' "$menu_options" | jq -r --arg title "$title" '.[$title]' | sed "s|^~/|$HOME/|")

    if [ "${path#/}" = "$path" ]; then
        echo "$path: must be an absolute path"
        continue
    elif [ ! -f "$path" ]; then
        echo "$path: no such file"
        continue
    fi

    basename=$(basename "$path" .exe)
    [ -f "${basename}.png" ] || exe2png "$path" || basename=

    icon_menu="${icon_menu}${title}\0icon\x1f${icon_dir}/${basename}.png\n"

done <<EOF
$titles
EOF

choice=$(printf '%b' "$icon_menu" | $menu)
[ -z "$choice" ] && exit 1

path=$(printf '%s' "$menu_options" | jq -r --arg choice "$choice" '.[$choice]' | sed "s|^~/|$HOME/|")

if [ "$path" = 'null' ] || [ -z "$path" ]; then
    exit 1
elif [ "$(file -b --mime-type "$path")" != application/vnd.microsoft.portable-executable ]; then
    echo "$path: not a windows executable" >&2
    exit 1
fi

cd "$(dirname "$path")"

basename=$(basename "$path" .exe)
env_file="$conf_dir/envvars/${basename}"
arg_file="$conf_dir/args/${basename}"

set --
if [ -f "$arg_file" ]; then
    while read -r arg || [ -n "$arg" ]; do
        set -- "$@" "$arg"
    done <"$arg_file"
fi

exec systemd-run --user \
    --unit="$basename" \
    --service-type=exec \
    --same-dir \
    --collect \
    --setenv=DXVK_CONFIG_FILE="$HOME/.config/dxvk/dxvk.conf" \
    --setenv=MANGOHUD=1 \
    --setenv=PROTONPATH=GE-Proton \
    --setenv=PROTON_ENABLE_WAYLAND=1 \
    --setenv=PROTON_OPTISCALER_CONFIG='Upscalers.Dx12Upscaler=fsr31;Menu.FpsOverlayType=1;Menu.DisableSplash=true;Plugins.LoadAsiPlugins=true' \
    --setenv=PROTON_USE_OPTISCALER=1 \
    --setenv=PROTON_USE_WOW64=1 \
    --setenv=WINEPREFIX="$conf_dir/prefixes/$basename" \
    --setenv=WINE_FULLSCREEN_INTEGER_SCALING=1 \
    --property=EnvironmentFile="-$env_file" \
    --property=ExecStartPre="'$HOME/.local/bin/gamemode-custom' start" \
    --property=ExecStopPost="'$HOME/.local/bin/gamemode-custom' stop" \
    umu-run "$path" "$@"
