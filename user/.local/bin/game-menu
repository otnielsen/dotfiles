#!/bin/sh

set -eu

menu='fuzzel --dmenu --only-match'
conf_dir=~/.config/game-menu
menu_options=$(find "$conf_dir/games" -maxdepth 1 -type l -xtype f -printf '%f\n')

icon_dir="$conf_dir/icons"
cd "$icon_dir"
icon_menu=''
while read -r title || [ -n "$title" ]; do
    path=$(realpath "$conf_dir/games/$title")

    basename=$(basename "$path" .exe)
    [ ! -f "${title}.png" ] &&
        exe2png "$path" &&
        [ "$basename" != "$title" ] &&
        mv "${basename}.png" "${title}.png"

    icon_menu="${icon_menu}${title}\0icon\x1f${icon_dir}/${title}.png\n"

done <<EOF
$menu_options
EOF

choice=$(printf '%b' "$icon_menu" | $menu)
[ -z "$choice" ] && exit 1

path=$(realpath "$conf_dir/games/$choice")

if [ "$(file -b --mime-type "$path")" != application/vnd.microsoft.portable-executable ]; then
    echo "$path: not a windows executable" >&2
    exit 1
fi

cd "$(dirname "$path")"

filename=$(printf '%s' "$choice" | iconv -t ASCII//TRANSLIT | sed 's/ /_/g ; s/[^a-zA-Z0-9_.-]//g')
env_file="$conf_dir/envvars/$filename"
arg_file="$conf_dir/args/$filename"

set --
if [ -f "$arg_file" ]; then
    while read -r arg || [ -n "$arg" ]; do
        set -- "$@" "$arg"
    done <"$arg_file"
fi

exec systemd-run --user \
    --unit="$filename" \
    --service-type=exec \
    --same-dir \
    --collect \
    --setenv=DXVK_CONFIG_FILE="$HOME/.config/dxvk/dxvk.conf" \
    --setenv=MANGOHUD=1 \
    --setenv=PROTONPATH=GE-Proton \
    --setenv=PROTON_ENABLE_WAYLAND=1 \
    --setenv=PROTON_OPTISCALER_CONFIG='Upscalers.Dx12Upscaler=fsr31;Menu.FpsOverlayType=1;Menu.DisableSplash=true;Plugins.LoadAsiPlugins=true' \
    --setenv=PROTON_USE_OPTISCALER=1 \
    --setenv=PROTON_USE_WOW64=1 \
    --setenv=WINEPREFIX="$conf_dir/prefixes/$filename" \
    --setenv=WINE_FULLSCREEN_INTEGER_SCALING=1 \
    --property=EnvironmentFile="-$env_file" \
    --property=ExecStartPre="'$HOME/.local/bin/gamemode-custom' start" \
    --property=ExecStopPost="'$HOME/.local/bin/gamemode-custom' stop" \
    umu-run "$path" "$@"
