#!/bin/sh

set -eu

raw=

raw="${raw}gamemode:,"
raw="${raw}$(gamemoded -s | awk '{ print $3 }')\n"

raw="${raw}scx:,"
raw="${raw}$(scxctl get)\n"

if [ "$XDG_SESSION_DESKTOP" = 'KDE' ]; then
    raw="${raw}hidecursor:,"
    raw="${raw}$(busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects isEffectLoaded s hidecursor |
        awk '{ print $2 }')\n"
fi

raw="${raw}governor:,"
raw="${raw}$(cat /sys/devices/system/cpu/cpufreq/policy*/scaling_governor | sort -u)\n"

raw="${raw}epp:,"
raw="${raw}$(cat /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference | sort -u)\n"

card=$(udevadm trigger --dry-run --verbose \
    --subsystem-match=pci \
    --property-match=DRIVER=amdgpu \
    --attr-match=unique_id=22190ab2d9cbbf14)
profile_file="$card/pp_power_profile_mode"

if [ -d "$card" ] && [ -f "$profile_file" ]; then
    raw="${raw}gpu_profile:,"
    raw="${raw}$(grep -om1 '\S*\*' "$profile_file")\n"
fi

printf '%b' "$raw" | column -ts ','
