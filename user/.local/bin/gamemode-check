#!/bin/sh

set -eu

gamemoded -s
scxctl get

if [ "$XDG_SESSION_DESKTOP" = 'KDE' ]; then
    printf 'hidecursor loaded? '
    busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects isEffectLoaded s hidecursor | awk '{ print $2 }'
fi

printf 'governor: '
cat /sys/devices/system/cpu/cpufreq/policy*/scaling_governor | sort -u

printf 'epp: '
cat /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference | sort -u

card=$(udevadm trigger --dry-run --verbose \
    --subsystem-match=pci \
    --property-match=DRIVER=amdgpu \
    --attr-match=unique_id=22190ab2d9cbbf14)
profile_file="$card/pp_power_profile_mode"

if [ -d "$card" ] && [ -f "$profile_file" ]; then
    printf 'gpu_profile: '
    grep -om1 '\S*\*' "$profile_file"
fi
